{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "description": "A simple helpdesk backend",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/server.ts",
    "test:dev": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --runInBand",
    "build": "tsup src --out-dir build --format esm --clean",
    "start": "node build/server.js",
    "postinstall": "prisma generate",
    "test": "jest --runInBand --detectOpenHandles --watchAll",
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "Lucas Castro",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.4",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
